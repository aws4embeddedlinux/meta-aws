diff --git a/src/source/Rtp/Codecs/RtpVP8Payloader.c b/src/source/Rtp/Codecs/RtpVP8Payloader.c
index e2227a5174..b1f99ef254 100644
--- a/src/source/Rtp/Codecs/RtpVP8Payloader.c
